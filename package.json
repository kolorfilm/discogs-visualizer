{
  "name": "discogs-visualizer",
  "version": "3.3.0",
  "description": "An app to visualize different data from discogs.com.",
  "author": "Michael Päßler",
  "scripts": {
    "dev": "ts-node server/index.ts",
    "build": "next build",
    "start": "NODE_ENV=production ts-node server/index.ts",
    "lint": "eslint",
    "lintAll": "next typegen && prettier --check . && eslint . && stylelint **/*.scss && tsc --noEmit",
    "test": "vitest",
    "testAll": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "prettier": "prettier --check .",
    "stylelint": "stylelint **/*.scss",
    "tsc": "next typegen && tsc --noEmit"
  },
  "dependencies": {
    "cookie": "^2.0.1",
    "cors": "^2.8.6",
    "disconnect": "^1.2.2",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "highcharts": "^13.1.1",
    "identity-obj-proxy": "^3.0.0",
    "next": "^16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass": "^1.105.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-private-methods": "^7.18.6",
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.3.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vitest/ui": "^5.0.2",
    "body-parser": "^2.3.0",
    "classnames": "^2.5.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-recommended-scss": "^17.0.1",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-order": "^8.1.1",
    "stylelint-prettier": "^5.0.3",
    "stylelint-scss": "^7.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vitest-fetch-mock": "^0.4.5"
  },
  "engines": {
    "node": "^24.11.0"
  }
